{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/DrivingLessons.Presentation.Web",
        "--launch-profile",
        "http"
      ],
      "port": 5080
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start",
        "--prefix",
        "client"
      ],
      "port": 4200
    }
  ]
}
